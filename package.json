{
  "name": "@sudobility/ratelimit_pages",
  "version": "1.0.215",
  "description": "Self-contained rate limit pages for React applications",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test:unit": "vitest run --exclude='**/*.integration.test.{ts,tsx}'",
    "test:watch": "vitest"
  },
  "keywords": [
    "react",
    "pages",
    "ratelimit",
    "usage",
    "dashboard",
    "typescript"
  ],
  "author": "John Q Huang",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/components": "^5.3.46",
    "@sudobility/design": "^1.1.66",
    "@sudobility/types": "^1.9.76",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@sudobility/ratelimit_client": {
      "optional": false
    },
    "@sudobility/ratelimit-components": {
      "optional": false
    }
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@sudobility/components": "^5.3.46",
    "@sudobility/design": "^1.1.66",
    "@sudobility/ratelimit_client": "^0.0.85",
    "@sudobility/ratelimit-components": "^1.0.11",
    "@sudobility/types": "^1.9.76",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "ajv": "~8.20.0",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "eslint": "~10.13.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "globals": "~17.13.0",
    "jsdom": "~30.1.3",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-helmet-async": "~3.0.0",
    "tailwind-merge": "~3.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.0",
    "vite": "~8.3.5",
    "vite-plugin-dts": "~4.5.4",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.52.5",
    "@rollup/rollup-linux-x64-musl": "4.52.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/ratelimit_pages.git"
  }
}
